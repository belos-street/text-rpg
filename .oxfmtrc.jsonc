{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": true,
  "bracketSpacing": true,
  "embeddedLanguageFormatting": "auto",
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "ignore",
  "insertPragma": false,
  "jsxSingleQuote": false,
  "printWidth": 80,
  "proseWrap": "preserve",
  "quoteProps": "as-needed",
  "requirePragma": false,
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false,
  // 额外忽略：构建产物 / 运行时数据 / 故事内容（与 eslint globalIgnores 对齐）
  // markdown 不参与格式化，避免文档（AGENTS.md、roadmap 等）产生无关改动
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".next",
    "out",
    "data",
    "assets",
    "game-data",
    "game-data-example",
    ".agents",
    "bun.lock",
    "*.md"
  ]
}
