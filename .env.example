# AI 配置
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=your-api-key-here
AI_MODEL=deepseek-chat

# ==========================================
# 支持的模型示例：
# ==========================================
# 
# --- 云端 API ---
# DeepSeek:
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_MODEL=deepseek-chat / deepseek-reasoner
#
# OpenAI:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o / gpt-4o-mini
#
# 硅基流动 (SiliconFlow):
#   AI_BASE_URL=https://api.siliconflow.cn/v1
#   AI_MODEL=Qwen/Qwen2.5-72B-Instruct
#
# Moonshot (月之暗面):
#   AI_BASE_URL=https://api.moonshot.cn/v1
#   AI_MODEL=moonshot-v1-8k
#
# --- 本地 LLM (OpenAI 兼容接口) ---
# Ollama:
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=       # 留空时自动使用占位 key，Ollama 不需要 API Key
#   AI_MODEL=llama3 / qwen2.5 / mistral
#
# LM Studio:
#   AI_BASE_URL=http://localhost:1234/v1
#   AI_API_KEY=       # 留空时自动使用占位 key
#   AI_MODEL=local-model
#
# 可选高级配置：
#   AI_REASONING=none|minimal|low|medium|high|xhigh   # 思考强度（仅本地端点透传；none 关闭思考，回复更快）
#   AI_STRUCTURED=auto|on|off                          # 结构化输出（auto=本地端点自动启用，语法层强制合法 JSON）
#
# LocalAI:
#   AI_BASE_URL=http://localhost:8080/v1
#   AI_API_KEY=       # 留空即可
#   AI_MODEL=gpt-4o-mini
#
# vLLM:
#   AI_BASE_URL=http://localhost:8000/v1
#   AI_MODEL=Qwen/Qwen2.5-7B-Instruct